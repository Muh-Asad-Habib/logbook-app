{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "frontend/out",
  "cleanUrls": true,
  "trailingSlash": false,
  "regions": ["sin1"],
  "functions": {
    "api/index.js": {
      "includeFiles": "backend/src/**",
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/:path*", "destination": "/api/index" }
  ]
}


