# ================================================================
#  Salin file ini menjadi `.env` (di folder logbook-app), lalu isi.
#  File .env TIDAK ikut ter-push ke GitHub (ada di .gitignore).
#  Panduan mendapatkan nilai-nilai ini: baca DEPLOY.md
# ================================================================

# --- Neon Postgres (data: akun, kegiatan, keuangan, pengaturan, log) ---
# Dapat dari: https://console.neon.tech  ->  proyekmu  ->  "Connect"
# Contoh: postgresql://user:password@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# --- ImageKit (penyimpanan foto, gratis 20 GB) ---
# Dapat dari: https://imagekit.io/dashboard/developer/api-keys
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=
# Folder di ImageKit tempat semua foto disimpan (opsional, default /logbook)
IMAGEKIT_FOLDER=/logbook

# --- Opsional ---
# Alamat publik aplikasi (tanpa garis miring akhir) — dipakai menyusun tautan
# penampil Office (Word/PowerPoint Online). Di Vercel otomatis memakai domain
# produksi; isi hanya bila memakai domain kustom. Di laptop boleh kosong.
# APP_ORIGIN=https://logbook-kamu.vercel.app

# --- Asisten AI (Ollama, server kampus) — semuanya opsional ---
# Bawaan sudah menunjuk ke server Informatika Unismuh; ubah bila memakai server lain.
# OLLAMA_URL=https://ollama.if.unismuh.ac.id
# Model BAWAAN — dipakai saat pengguna memilih "Otomatis" di panel asisten.
# Pengguna bebas memilih model lain sendiri (daftarnya diambil dari server:
# GET <OLLAMA_URL>/api/tags) dan pilihannya tersimpan per akun.
# OLLAMA_MODEL=qwen2.5:7b-instruct
# Isi hanya bila server mewajibkan header Authorization: Bearer …
# OLLAMA_API_KEY=
# Model berakhiran ":cloud" hanya penerus ke layanan awan Ollama dan menuntut
# kredensial tersendiri (di server kampus selalu membalas 401), jadi tidak
# ditawarkan. Setel 1 bila pemasanganmu memang punya kredensialnya.
# AI_MODEL_AWAN=0
# Setel 1 untuk mematikan seluruh fitur AI (tombol & endpoint /api/ai hilang).
# AI_NONAKTIF=0

